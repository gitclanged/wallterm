<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>WallTerm</RootNamespace>
    <AssemblyName>WallTerm</AssemblyName>
    <Version>1.0.1</Version>
    <Product>WallTerm</Product>
    <Description>Live PowerShell terminal as the Windows desktop background.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Build for the machine's own architecture (win-arm64 on Snapdragon XPS 13, win-x64 on Intel) unless -r is given. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- Run on a newer .NET Desktop Runtime (9, 10, ...) when 8 is not installed. -->
    <RollForward>Major</RollForward>

    <!-- Single-file publish: everything (incl. native WPF libs when self-contained) inside one exe. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>

    <!-- Low-overhead runtime: workstation GC without the background GC thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
